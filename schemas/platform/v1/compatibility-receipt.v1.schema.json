{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrale.ai/schemas/platform/v1/compatibility-receipt.v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "CompatibilityReceipt",
  "description": "Pass or fail for runtime commit x model revision x quantization x hardware fingerprint x topology, with the checks, parameters, artifacts and failures.",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "common.v1.schema.json#/$defs/version"
    },
    "key": {
      "type": "object",
      "properties": {
        "runtime_commit": {
          "$ref": "common.v1.schema.json#/$defs/git_commit"
        },
        "model": {
          "$ref": "common.v1.schema.json#/$defs/model_revision"
        },
        "quantization": {
          "$ref": "common.v1.schema.json#/$defs/quantization"
        },
        "hardware_fingerprint": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "topology": {
          "$ref": "common.v1.schema.json#/$defs/topology"
        }
      },
      "required": [
        "runtime_commit",
        "model",
        "quantization",
        "hardware_fingerprint",
        "topology"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "verdict": {
      "oneOf": [
        {
          "const": "pass"
        },
        {
          "type": "object",
          "properties": {
            "fail": {
              "type": "object",
              "properties": {
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check": {
                        "$ref": "common.v1.schema.json#/$defs/text"
                      },
                      "kind": {
                        "enum": [
                          "incoherent_output",
                          "below_threshold",
                          "crashed",
                          "timeout",
                          "invalid_tool_call",
                          "invalid_structured_output",
                          "unsupported"
                        ]
                      }
                    },
                    "required": [
                      "check",
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "failures"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "fail"
          ],
          "additionalProperties": false
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "common.v1.schema.json#/$defs/text"
          },
          "kind": {
            "enum": [
              "coherence",
              "benchmark",
              "accuracy",
              "tool_call",
              "structured_output",
              "conformance"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "$ref": "common.v1.schema.json#/$defs/flag_key"
            },
            "additionalProperties": {
              "$ref": "common.v1.schema.json#/$defs/value"
            }
          },
          "artifact": {
            "$ref": "common.v1.schema.json#/$defs/artifact_ref"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "common.v1.schema.json#/$defs/text"
                },
                "unit": {
                  "enum": [
                    "count",
                    "permille",
                    "milliseconds",
                    "microseconds",
                    "milli_tokens_per_second",
                    "millijoules_per_token",
                    "bytes"
                  ]
                },
                "value": {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                }
              },
              "required": [
                "name",
                "unit",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "kind",
          "passed",
          "parameters",
          "artifact",
          "metrics"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "started_at_unix_ms": {
      "$ref": "common.v1.schema.json#/$defs/timestamp_ms"
    },
    "finished_at_unix_ms": {
      "$ref": "common.v1.schema.json#/$defs/timestamp_ms"
    },
    "runner": {
      "$ref": "common.v1.schema.json#/$defs/software_version"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "key",
    "recipe",
    "verdict",
    "checks",
    "started_at_unix_ms",
    "finished_at_unix_ms",
    "runner",
    "synthetic"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "passed": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "not": {
              "const": "pass"
            }
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "passed": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ]
}
