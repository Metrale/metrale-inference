{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metrale.ai/schemas/platform/v1/deployment-action.v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "DeploymentAction",
  "description": "A typed, idempotent command from the plane to one agent; never a command line.",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "common.v1.schema.json#/$defs/version"
    },
    "idempotency_key": {
      "$ref": "common.v1.schema.json#/$defs/id16"
    },
    "trace_id": {
      "$ref": "common.v1.schema.json#/$defs/trace_id"
    },
    "scope": {
      "$ref": "common.v1.schema.json#/$defs/scope"
    },
    "deployment": {
      "$ref": "common.v1.schema.json#/$defs/dns_label"
    },
    "generation": {
      "$ref": "common.v1.schema.json#/$defs/generation"
    },
    "node_id": {
      "$ref": "common.v1.schema.json#/$defs/id32"
    },
    "action": {
      "enum": [
        "apply",
        "stop"
      ]
    },
    "issued_at_unix_ms": {
      "$ref": "common.v1.schema.json#/$defs/timestamp_ms"
    }
  },
  "required": [
    "version",
    "idempotency_key",
    "trace_id",
    "scope",
    "deployment",
    "generation",
    "node_id",
    "action",
    "issued_at_unix_ms"
  ],
  "additionalProperties": false
}
