      "required": [
        "mode",
        "rows",
        "digest",
        "groups"
      ],
      "type": "object"
    },
    "CardPlanGap": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "reason": {
          "type": "string"
