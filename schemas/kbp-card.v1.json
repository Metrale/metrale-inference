            "$ref": "#/$defs/CardEvidence"
          },
          "type": "array"
        },
        "execution": {
          "type": "string"
        },
        "exported_by": {
          "type": "string"
        },
        "hardware": {
          "$ref": "#/$defs/CardHardware"
        },
        "kernels": {
          "$ref": "#/$defs/CardKernels"
        },
        "lineage": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/CardModel"
        },
        "name": {
          "type": "string"
        },
        "performance": {
          "items": {
            "$ref": "#/$defs/CardPerformance"
          },
          "type": "array"
        },
        "plan_gaps": {
          "items": {
            "$ref": "#/$defs/CardPlanGap"
          },
          "type": "array"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/CardPlan"
          },
          "type": "array"
