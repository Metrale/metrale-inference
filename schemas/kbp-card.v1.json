        "schema",
        "blueprint_id",
        "lineage",
        "revision",
        "name",
        "exported_by",
        "model",
        "hardware",
        "precision",
        "execution",
        "kernels",
        "plans",
        "plan_gaps",
        "sizes",
        "signature",
        "performance",
        "evidence"
