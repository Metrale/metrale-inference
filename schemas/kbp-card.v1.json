        "draw_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "env_sha256": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "record_sha256": {
          "type": "string"
        }
